# Copy this file to .env.staging / .env.production and fill in real values.
# Never commit files with real credentials to git.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4001
NODE_ENV=production

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_SECRET2=your-jwt-refresh-secret-min-32-chars

# ── Database ─────────────────────────────────────────────────────────────────
# NOTE: configs[0] (soporte/directorio) and configs[1] (main app) both use
# these same env vars. In production they point to BD_FACTURADOR.
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASS=your-db-password
DB_NAME=BD_FACTURADOR

# ── FTP (image uploads) ───────────────────────────────────────────────────────
FTP_HOST=your-ftp-host
FTP_USER=your-ftp-user
FTP_PASS=your-ftp-password

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. No spaces.
CORS_ORIGINS=http://localhost:5173,http://your-production-ip

# ── Business constants ────────────────────────────────────────────────────────
IGV_RATE=0.18
EMPRESA_RUC=20522094120
