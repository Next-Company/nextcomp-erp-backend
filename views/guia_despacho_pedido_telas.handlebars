<style>
  /*html{
    overflow: hidden;
  }*/
  html::-webkit-scrollbar {
    width: 6px;
    height: 6px;
    /* background: #efefef; */
    background: transparent;
  }
  html::-webkit-scrollbar-thumb {
    background: #c2c2c2;
    border-radius: 6px;
  }
  html::-webkit-scrollbar-thumb:hover {
    background: #555;
  }

  * {
      font-family: calibri;
      font-size: 12px;
      color: #000000;
  }

  body {
      background-color: white;
      padding: 0px 20px 0px;
      margin: 0px;
      height: 28cm;
      position: relative;
      box-sizing: border-box;
      /*border-right: 1px dashed gray;*/
  }

  table {
      padding: 2px
  }
  table#principal {
      /* border-spacing: 2px 5px; */
  }
  table#principal td {
      /* padding:0xpx */
  }

  table.contenido td {
      text-transform: uppercase;
  }

  table.contenido{
    /* width: 100%; */
    border-collapse: collapse;
    {{!-- border-left: 0.5px solid #004080; --}}
  }


  table.contenido tbody tr th, thead tr th {
      background-color: #a8ac5c;
      border-right: 0.5px solid #004080;
      border-bottom: 0.5px solid #004080;
      border-top: 0.5px solid #004080;
      text-align: center;
      font-weight: bolder;
      height: 16px;
      line-height: 11px;
      color:white;
  }


  table.contenido tbody tr td {

      border-right: 0.5px solid #a8ac5c;
      border-bottom: 0px solid #a8ac5c;

      padding: 5px 5px;
      line-height: 8px;
  }
  table.contenido2 {
    border-collapse: collapse; 
  }
  table.contenido2 tr td {
    border-left: 0.5px solid black;
    border-top: 0.5px solid black;
    border-right: 0.5px solid black;
    border-bottom: 0.5px solid black;
    padding: 5px 5px;
    line-height: 8px;
  }

  table.tabla_datos {
    border: 0.5px solid #004080;
    border-collapse: separate;
    border-spacing: 3px;
    padding: 0.0px;
    line-height: 7px;
  }
  .saltopagina {
      display: block;
      border: none;
      page-break-after: always;
  }
  .tipo_orden td{
      border:0.5px solid black;
  }
  @media print {
    /* Asegura que el footer se imprima al final de la última página */
    tfoot {
      display: table-row-group;
    }

    .footer-contenido {
      /* Si quieres que se vea abajo del todo, 
        puedes darle un margen superior grande 
        o una altura mínima */
      padding-top: 20px;
      border-top: 1px solid #000;
      text-align: center;
    }

    /* Evita que una fila se corte a la mitad */
    tr {
      page-break-inside: avoid;
      break-inside: avoid;
    }
  }
</style>
<body>
  <div style="break-after: page">
    <table id="principal" style="width: 100%;">
        <tr>
            <td>
                <table style="border: 1px solid red;border-collapse:collapse;width:100%;">
                  <tr>
                    
                    <td style="text-align: center;border: 0.5px solid blue;border:1px solid;">
                      <table style="border-collapse: collapse; padding: 6px 1px;margin: 0px; width:100%;">
                        <tr>
                          <td>
                            <table class="tipo_orden" style="width: 100%;">
                              <tr>
                                <td style="border:none;">
                                  <table style="border-collapse: collapse; padding: 6px 1px;margin: 0px; width:100%;">
                                    <tr>
                                      <td style="border:0px solid black;font-weight:bold;font-size:16px;text-align:center;padding:5px;">
                                        <div style="display:flex;flew-direction:row;justify-content:between;align-items:center; width:100%;">
                                          <div style="">
                                            <h2 style="font-size:27px;margin:0px;">GUIA DE INGRESO</h2>
                                          </div>
                                          <div style="flex:1;text-align:right;font-size:20px;">
                                            #{{idguia}}
                                          </div>
                                        </div>
                                      </td>
                                    </tr>
                                  </table>
                                </td>
                              </tr>
                            </table>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
            </td>
        </tr>
        <!-- fin de cabecera -->
        <tr>
          <td>

            <table class="tabla_datos" style="width: 100%;height:62px;">
              <tbody >
                {{#encabezado cabecera}}
                {{/encabezado}}
              </tbody>
            </table>

          </td>
        </tr>
    </table>
    <br />
    <table class="contenido" style="width:100%;">
        <thead>
            <tr nobr="true" style="height:40px;">
                <th style="width:35px;font-size:9px;">Item</th>
                <th style="width:750px;font-size:9px;">Descripci&oacute;n</th>
                <th style="font-size:9px;">COLOR</th>
                <th style="font-size:9px;">U.M.</th>
                <th style="font-size:9px;">Peso(Kg)</th>
                <th style="font-size:9px;">Prog.</th>
                <th style="font-size:9px;">Pendiente</th>
                <th style="font-size:9px;">Ingreso</th>
                <th style="font-size:9px;">Costo</th>
                <th style="font-size:9px;">Importe</th>
            </tr>
        </thead>
        <tbody>
          {{#cuerpo detalle}}
          {{/cuerpo}}
      </tbody>
      <tfoot>
        <tr>
          <td colspan="10">

            <div style="bottom:0px;display:flex;width:100%;gap:15px;flex-direction:column;padding-top:50px;">
              <div style="display:flex;width:95%;gap:15px;">
                <div style="height:20px;background-color:transparent;flex:1;text-align:center;border-top:thin dashed;padding-top:5px;">AUXILIAR DE ALMACEN</div>
                <div style="height:20px;background-color:transparent;flex:1;text-align:center;border-top:thin dashed;padding-top:5px;">CONTROL DE INGRESO</div>
              </div>
              <div style="font-weight: bold;font-size:12px;text-align:right;padding:10px;border:0px solid red;margin-right: 20px;">
                Fecha/hora emisión: {{cabecera.fecha_sistema}}
              </div>
            </div>

          </td>
        </tr>
      </tfoot>
    </table>

    {{!-- <div style="bottom:0px;display:flex;width:100%;gap:15px;flex-direction:column;">
      <div style="display:flex;width:95%;gap:15px;">
        <div style="height:20px;background-color:transparent;flex:1;text-align:center;border-top:thin dashed;padding-top:5px;">AUXILIAR DE ALMACEN</div>
        <div style="height:20px;background-color:transparent;flex:1;text-align:center;border-top:thin dashed;padding-top:5px;">JEFE DE CORTE</div>
      </div>
      <div style="font-weight: bold;font-size:12px;text-align:right;padding:10px;border:0px solid red;margin-right: 20px;">
        Fecha/hora emisión: {{cabecera.fecha_sistema}}
      </div>
    </div> --}}
    <style>
        table#totales {
            border: 0.5px solid #004080;
        }

        table#totales .texto {
            border-right: 0.5 solid #004080;
            width: 72px;
        }

        table#totales .numero {
            text-align: right;
            width: 69px;
        }

        table#totales .borde_alto {
            border-top: 0.5px solid #004080;
        }

        table#totales .sombra {
            background-color: #a2d8f4;
            border: 0.5px solid #004080;
        }
    </style>
  </div>
</body>