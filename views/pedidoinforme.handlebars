<style>
  :root{
    font-size: 10px;
    font-family: Arial, Helvetica, sans-serif;
  }
  .cuerpo_estampado{
    width: 100%;
    /*height: 200px;*/
    border:1px solid gray;
    border-radius: 10px;
    background-color: rgba(241, 241, 241, 0.5);
    margin-bottom: 10px;
    position: relative;
  }
  .main_informe{
    /*padding:0.2cm;*/
    display: flex;
    flex-direction: row;
    height: 27cm;
  }
  .main_informe h2{
    font-size: 1.2rem;
  }
  .indice_estampado{
    position: absolute;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 50%;
    width: 25px;
    height: 25px;
    left: -15px;
    top: -10px;
    background-color: white;
    border: 0.2px solid black;
  }
  .cuerpo_estampado .indicador span{
    font-size: .8rem;
  }
  .cuerpo_estampado .indicador div{
    padding: 5px;
  }
  .indicador{
    flex:1;
  }
  .nowrap_space{
    white-space: nowrap;
  }
</style>
