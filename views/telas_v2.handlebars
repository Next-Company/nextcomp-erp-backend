{{#> guia-ingreso}}

{{!-- {{> datos-proveedor}} --}}

<section style="padding: 10px 0; margin: 8px 0;">

  <table style="
    border-collapse:collapse;
    width:100%;
    table-layout:fixed;
    font-size:9px;
    border-top:1px solid #000;
  ">

    <!-- HEADER -->
    <thead>
      <tr style="height:22px; background-color:#b4c7e7;">
        <th style="width:4%; border-left:1px solid #000; border-right:1px solid #000; font-weight:bold;">Item</th>
        <th
          style="width:30%; border-left:1px solid #000; border-right:1px solid #000; text-align:left; padding-left:4px; font-weight:bold;">
          Descripción</th>
        <th
          style="width:8%; border-left:1px solid #000; border-right:1px solid #000; text-align:center; font-weight:bold;">
          Rollo</th>
        <th
          style="width:10%; border-left:1px solid #000; border-right:1px solid #000; text-align:right; font-weight:bold;">
          Cantidad</th>
        <th
          style="width:8%; border-left:1px solid #000; border-right:1px solid #000; text-align:center; font-weight:bold;">
          U.M.</th>
        <th
          style="width:10%; border-left:1px solid #000; border-right:1px solid #000; text-align:right; font-weight:bold;">
          Precio</th>
        <th
          style="width:12%; border-left:1px solid #000; border-right:1px solid #000; text-align:right; font-weight:bold;">
          Importe</th>
      </tr>
    </thead>

    <!-- BODY -->
    <tbody>
      {{{cuerpoTelas detalle}}}
    </tbody>

    <!-- FOOTER -->
    <tfoot>
      <tr>
        <td colspan="4"></td>

        <td style="
          border-left:1px solid #000;
          border-right:1px solid #000;
          border-top:1px solid #000;
          border-bottom:1px solid #000;
          text-align:right;
          font-weight:bold;
        ">
          TOTAL
        </td>

        <td style="
          border-left:1px solid #000;
          border-right:1px solid #000;
          border-top:1px solid #000;
          border-bottom:1px solid #000;
          text-align:right;
          padding-right:3px;
          font-weight:bold;
        ">
          {{totalImporte}}
        </td>

        <td style="
          border-left:1px solid #000;
          border-right:1px solid #000;
          border-top:1px solid #000;
          border-bottom:1px solid #000;
        ">
        </td>
      </tr>
    </tfoot>

  </table>
  <section style="
    margin-top:10px;
    padding:8px;
    border:.5px dashed #666;
    font-size:8px;
  ">
    <strong>OBSERVACIONES:</strong>
    <div style="margin-top:4px; line-height:1.4;">{{observaciones}}</div>
  </section>

  {{> condiciones-penalidades condicion_pago=condicion_pago}}
</section>

{{!-- {{> footer-firmas}} --}}

{{/guia-ingreso}}