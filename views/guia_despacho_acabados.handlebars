{{!-- guia_despacho_acabados.handlebars --}}

<style>
  @media print{
    div.main_informe.change_color{
      color:'red'
    }
  }
  :root{
    --color: #000000;
    font-size: 14px;
    font-family: Arial, Helvetica, sans-serif;
    --background-color: rgb(255, 241, 221);
  }
  .main_informe{
    /*padding:0.2cm;*/
    display: flex;
    flex-direction: row;
    height: 196mm;
  }
  .main_informe h2{
    font-size: 1.2rem;
  }
  .indice_estampado{
    position: absolute;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 50%;
    width: 25px;
    height: 25px;
    left: -15px;
    top: -10px;
    background-color: white;
    border: 0.2px solid black;
  }
  .indicador{
    flex:1;
  }
  .nowrap_space{
    white-space: nowrap;
  }
</style>
<div class="main_informe" style="color:{{color}}">
  <div style="flex:1;padding:5px;display:flex;flex-direction:column;">
    <section style="flex:1;">
      <div style="font-weight:bolder;text-align:center;border-bottom:1.5px solid black;border-top:1.5px solid black;padding:8px 0px;position:relative;display:flex;flex-direction:row;justify-content:space-between;align-items:center;">
        <div style="font-size:1.8rem;display:flex;gap:10px;align-items:center;">
          <div>GUIA DE PREDESPACHO</div>
        </div>
        <div style="display: flex;gap:20px;">
          <div style="display: flex;flex-direction: column;">
            <div style="font-size: 10px;"># ORDEN</div>
            <div style="font-size: 1.5rem;">{{cabecera.nro_orden_origen}}</div>
          </div>
        </div>
      </div>
      <p style="font-size: .9rem;font-weight:bolder;">
        DATOS DEL INGRESO:<br/>
      </p>
      <section style="border-bottom:.5px dashed black;font-size:.9rem;padding-bottom: 10px;">
        <table>
          <tbody>
            <tr>
              <td>Proveedor:</td>
              <td style="width: 500px;">{{proveedor.nom}}</td>
              <td>Contacto:</td>
              <td style="width: 200px;">{{cabecera.responsable}}</td>
              <td>Servicio/Motivo:</td>
              <td>ACABADOS</td>
            </tr>
          </tbody>
        </table>
      </section>
      <p style="font-size: .9rem;font-weight:bold;">
        RESUMEN DETALLE:<br/>
      </p>
      <section style="font-size:.9rem; padding-bottom: 10px;">
        <table style="border-collapse: collapse;width:100%;">
          <thead>
            <tr style="border-bottom:.2px solid gray;">
              <th>#</th>
              <th style="text-align:left;">Artículos de producción</th>
              <th style="text-align:right;width:100px;"></th>
              <th style="text-align:center;">Qty</th>
              <th style="text-align:center;">XS/26</th>
              <th style="text-align:center;">S/28</th>
              <th style="text-align:center;">M/30</th>
              <th style="text-align:center;">L/32</th>
              <th style="text-align:center;">XL/34</th>
              <th style="text-align:center;">XXL/36</th>
              <th style="text-align:center;">UM</th>
              <th style="text-align:center;">Ing.</th>
              <th style="text-align:center;">Icp.</th>
              <th style="text-align:center;">Cdo.</th>
            </tr>
          </thead>
          <tbody>
            {{#each detalle}}
              <tr style="">
                <td style="text-align: center;width:.5cm;">{{plusindex @index}}</td>
                <td style="font-weight: bold;">{{articulo}}</td>
                <td></td>
                <td style="width:60px;text-align: center;">{{cantidad}}</td>
                {{#each fracciones_despacho_cantidad}}
                  <td style="text-align: center;font-weight: bold;">{{this}}</td>
                {{/each}}
                <td style="width:1.5px;text-align: center;">NIU</td>
                <td style="width:60px;text-align: center;">{{despacho}}</td>
                <td style="width:60px;text-align: center;">{{incompletos}}</td>
                <td style="width:60px;text-align: center;">{{caidos}}</td>
              </tr>
            {{/each}}
            <tfoot>
              <tr>
                <td colspan="2"></td>
                <td style="text-align: center;font-size:.9rem;"><strong>Total</strong></td>
                <td style="text-align: center;font-size:.9rem;"><strong>{{totalunid}}</strong></td>
                <td colspan="7"></td>
                <td style="text-align: center;font-size:.9rem;"><strong>{{totaldespacho}}</strong></td>
                <td style="text-align: center;font-size:.9rem;"><strong>{{totalincompletos}}</strong></td>
                <td style="text-align: center;font-size:.9rem;"><strong>{{totalcaidos}}</strong></td>
              </tr>
            </tfoot>
          </tbody>
        </table>
      </section>
    </section>
    <footer>
      <section style="display:flex;justify-content:space-around;gap:15px;">
        <div style="border-top:.5px dashed black;padding:5px;text-align:center;flex:1;font-size:.9rem;">
          Asistente almacén
          <div style="text-align:left;height:30px;border-bottom:.5px dotted gray;display:flex;align-items:center;">Nom:</div>
        </div>
        <div style="border-top:.5px dashed black;padding:5px;text-align:center;flex:1;font-size:.9rem;">
          Control de ingreso
          <div style="text-align:left;height:30px;border-bottom:.5px dotted gray;display:flex;align-items:center;">Nom:</div>
        </div>
      </section>
      <section style="padding-top:10px;font-size:.9rem;display:flex;justify-content:between;">
        <div style="flex:1;">
          {{!-- <strong>Observaciones: </strong>{{cabecera.observaciones}} --}}
        </div>
        <div>
          <strong>Fecha/hora emisión: {{date}} {{time}}</strong><br/>
        </div>
      </section>
    </footer>
  </div>
</div>
<div sytle="position:absolute;width:150px;height:150px;border-radius:50%;top:100px;left:100px;"></div>
<script>
  var r = document.querySelector(':root')
  var rs = getComputedStyle(r);
  r.style.setProperty('--color', '#000000');
</script>
