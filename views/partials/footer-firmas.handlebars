{{!-- footer-firmas.handlebars - VERSIÓN CORREGIDA Y ESTANDARIZADA --}}
<footer style="margin-top: 15px; font-size: 0.75rem; color: #333;">

  <!-- FIRMAS -->
  <section style="
    display: flex;
    justify-content: space-between;
    gap: 60px;
    padding: 40px 20px 30px 20px;
  ">
    {{#each firmas}}
      <div style="
        border-top: 1.5px dashed #666;
        padding-top: 8px;
        text-align: center;
        flex: 1;
        min-width: 0;
      ">
        <strong>{{this}}</strong>
      </div>
    {{/each}}
  </section>

  <!-- INFORMACIÓN DE EMISIÓN (discreta) -->
  <section style="
    display: flex;
    justify-content: space-between;
    font-size: 0.68rem;
    color: #555;
    border-top: 0.5px dashed #ccc;
    padding-top: 8px;
  ">

    <!-- Izquierda: Emisor -->
    <div>
      {{#if emisor}}
        Emitido por: <span style="font-weight: 600;">{{emisor}}</span>
      {{/if}}
    </div>

    <!-- Derecha: Fecha y hora -->
    <div>
      Fecha/hora de emisión:
      <strong>{{date}} {{time}}</strong>
    </div>

  </section>

</footer>