{{!-- document-header.handlebars - VERSIÓN CORREGIDA Y ESTANDARIZADA --}}
<table style="width:100%; border:1px solid white;">
  <tbody>
    <tr>

      <!-- BLOQUE IZQUIERDO: LOGO + DATOS EMPRESA (68%) -->
      <td style="width:68%; padding:8px 5px; text-align:center; vertical-align:top;">
        <table style="width:100%; font-size:10px;">
          <tbody>
            <tr>
              <td style="text-align:center;">
                <img src="http://192.168.18.20:5173/images/logo_next-02.jpg" 
                     style="width:220px; max-width:100%; height:auto;" 
                     alt="NEXT COMPANY S.A.C" />
              </td>
            </tr>
            <tr>
              <td style="padding-top:12px; line-height:1.45;">
                Calle Felipe Santiago Crespo Nro 581 - San Luis - Lima - Lima<br/>
                R.U.C. 20522094120<br/>
                Telf: 3233128<br/>
                <strong>next.company.sac@gmail.com</strong>
              </td>
            </tr>
          </tbody>
        </table>
      </td>

      <!-- BLOQUE DERECHO: TÍTULO + NÚMERO + FECHAS (32%) -->
      <td style="width:32%; padding:8px 5px; text-align:center; vertical-align:top;">

        <table style="border-collapse:collapse; width:100%;">
          <tbody>

            <!-- TÍTULO DEL DOCUMENTO -->
            <tr>
              <td colspan="2" 
                  style="border:1px solid black; 
                         font-weight:bold; 
                         font-size:15px; 
                         text-align:center; 
                         padding:6px 8px; 
                         background-color: #b4c7e7;">
                {{documentTitle}}
              </td>
            </tr>

            <!-- NÚMERO DE DOCUMENTO -->
            <tr>
              <td style="height:32px; 
                         width:145px; 
                         font-weight:bolder; 
                         border:1px solid black; 
                         padding:4px 8px; 
                         text-align:left; 
                         font-size:11px;">
                {{documentNumberLabel}}
              </td>
              <td style="border:1px solid black; 
                         padding:4px; 
                         font-weight:bold; 
                         font-size:18px; 
                         text-align:center;">
                {{documentNumber}}
              </td>
            </tr>

            <!-- FECHAS -->
            {{#if documentDeliveryDate}}
            <tr>
              <td style="height:26px; 
                         font-weight:bolder; 
                         border:1px solid black; 
                         font-size:10.5px; 
                         padding:4px 8px;">
                Fecha Emisión: <strong>{{documentDate}}</strong>
              </td>
              <td rowspan="2" 
                  style="border:1px solid black; 
                         font-weight:bold; 
                         text-align:center; 
                         font-size:10.5px; 
                         padding:4px 8px; 
                         vertical-align:middle;">
                Tiempo de producción:<br/>
                {{#if documentDiasProduccion}}
                  <span style="font-size:11px;">{{documentDiasProduccion}} días</span>
                {{/if}}
              </td>
            </tr>

            <tr>
              <td style="height:26px; 
                         font-weight:bolder; 
                         border:1px solid black; 
                         font-size:10.5px; 
                         padding:4px 8px;">
                Fecha Entrega: <strong>{{documentDeliveryDate}}</strong>
              </td>
            </tr>
            {{else}}
            <tr>
              <td colspan="2" 
                  style="height:32px; 
                         font-weight:bolder; 
                         border:1px solid black; 
                         font-size:11px; 
                         padding:6px 8px;">
                Fecha: <strong>{{documentDate}}</strong>
              </td>
            </tr>
            {{/if}}

          </tbody>
        </table>

      </td>

    </tr>
  </tbody>
</table>