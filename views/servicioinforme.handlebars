<style>
  :root{
    font-size: 10px;
    font-family: Arial, Helvetica, sans-serif;
  }
  .cuerpo_estampado{
    width: 100%;
    /*height: 200px;*/
    border:1px solid gray;
    border-radius: 10px;
    background-color: rgba(241, 241, 241, 0.5);
    margin-bottom: 10px;
    position: relative;
  }
  .main_informe{
    /*padding:0.2cm;*/
    display: flex;
    flex-direction: row;
    height: 27cm;
  }
  .main_informe h2{
    font-size: 1.2rem;
  }
  .indice_estampado{
    position: absolute;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 50%;
    width: 25px;
    height: 25px;
    left: -15px;
    top: -10px;
    background-color: white;
    border: 0.2px solid black;
  }
  .cuerpo_estampado .indicador span{
    font-size: .8rem;
  }
  .cuerpo_estampado .indicador div{
    padding: 5px;
  }
  .indicador{
    flex:1;
  }
  .nowrap_space{
    white-space: nowrap;
  }
</style>
<div class="main_informe">  
  {{!-- <div style="flex:1;padding:5px;border:1px solid green;"> --}}
  <div style="flex:1;padding:5px;display:flex;flex-direction:column;">
    <section style="flex:1;">
      <br/>
      <br/>
      <br/>
      <p style="font-size: 1.2rem;font-weight:600;text-align:center;">
        NEXT COMPANY S.A.C<br/>
        NEXT
      </p>
      <section style="font-size:.8rem;border-bottom:.5px dashed black;text-align:center;">
        <p>
          DOMICILIO FISCAL: CAL.FELIPE SANTIAGO CRESPO NRO. 581 LIMA - LIMA - SAN LUIS, RUC: 20522094120<br/>
        </p>
      </section>
      <p style="font-size: 1.1rem;font-weight:bolder;text-align:center;">
        CUADRE PEDIDO Y DESPACHOS - {{datos.tipo}}<br/>
        {{!-- {{idguia}} --}}
      </p>
      <section style="display: flex;justify-content:space-between;border-bottom:.5px dashed black;padding-bottom: 10px;">
        <div style="font-size: .9rem;text-align:center;">
          <strong>FECHA DE EMISIÓN:</strong> 
          {{datos.fec_emision_guia}}
        </div>
        <div style="font-size: .9rem;text-align:center;">
          <strong>HORA DE EMISIÓN:</strong> 
          {{time}}
        </div>
        <div style="font-size: .9rem;text-align:center;">
          <strong>FECHA DE RETORNO:</strong> 
          {{datos.fec_retorno_guia}}
        </div>
        <div style="font-size: .9rem;text-align:center;">
          <strong>DÍAS PRODUCCIÓN:</strong> 
          {{datos.duracion}}
        </div>
      </section>
      <p style="font-size: 1.1rem;font-weight:bolder;">
        DATOS DEL SERVICIO:<br/>
      </p>
      <section style="border-bottom:.5px dashed black;font-size:.9rem;padding-bottom: 10px;">
        <table>
          <tbody>
            <tr>
              <td>Proveedor:</td>
              <td style="width: 300px;">
                {{datos.proveedor}}
              </td>
              <td>Producción:</td>
              <td>
                {{datos.duracion}}
              </td>
            </tr>
            <tr>
              <td>Forma de Pago:</td>
              <td>dd</td>
              <td>Girador por:</td>
              <td>
                {{datos.responsable}}
              </td>
            </tr>
          </tbody>
        </table>
      </section>
      <p style="font-size: 1.1rem;font-weight:bold;">
        INFORME DESPACHOS:<br/>
      </p>
      <section style="font-size:.9rem; padding-bottom: 10px;">
        <table style="border-collapse: collapse;width:100%;">
          <thead>
            <tr style="border-bottom:.2px solid gray;">
              <th>#</th>
              <th style="text-align:left;font-size:0.65rem;">Descripcion</th>
              <th style="text-align:center;font-size:0.65rem;">Envio</th>
              <th style="text-align:center;font-size:0.65rem;">Costo</th>
              <th style="text-align:center;font-size:0.65rem;">Importe Inicial</th>              
              <th style="text-align:center;font-size:0.65rem;">Ingresos</th>
              {{!-- {{#each despachos}}
              <th style="text-align:center;font-size:0.65rem;">Ingreso{{plusindex @index}}</th>
              {{/each}} --}}
              <th style="text-align:center;font-size:0.65rem;">Diferencia</th>
              {{!-- <th style="text-align:center;font-size:0.65rem;">PrecioIng.</th> --}}
              <th style="text-align:center;font-size:0.65rem;">Importe Final</th>
            </tr>
          </thead>
          <tbody>
            {{#foo detalle}}
            {{/foo}}
          </tbody>
        </table>
      </section>
    </section>
  </div>
</div>