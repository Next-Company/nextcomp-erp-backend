<style>
  :root{
    font-size: 12px;
    font-family: Arial, Helvetica, sans-serif;
  }
  .cuerpo_estampado{
    width: 100%;
    /*height: 200px;*/
    border:1px solid gray;
    border-radius: 10px;
    background-color: rgba(241, 241, 241, 0.5);
    margin-bottom: 10px;
    position: relative;
  }
  .main_informe{
    padding:1cm;
    width: 21cm;
    height: 20.7cm;
  }
  .main_informe h2{
    color: red;
  }
  .indice_estampado{
    position: absolute;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 50%;
    width: 25px;
    height: 25px;
    left: -15px;
    top: -10px;
    background-color: white;
    border: 0.2px solid black;
  }
  .cuerpo_estampado .indicador span{
    font-size: .8rem;
  }
  .cuerpo_estampado .indicador div{
    padding: 5px;
  }
  .indicador{
    flex:1;
  }
  .nowrap_space{
    white-space: nowrap;
  }
</style>
<div class="main_informe">
  {{!-- <h2>Informe estampado</h2> --}}
  <h2>Informe estampado día {{fecha}}</h2>
  {{#each detalle}}
    <div class="cuerpo_estampado">
      <div class="indice_estampado">{{@index}}</div>
      <div style="padding:10px;">
        {{!-- <span style="font-size: .8rem;font-weight:600;">Modelo:{{modelo}}</span> --}}
        {{!-- <br/> --}}
        <div >
          <div style="display: flex;gap:10px;">
            <div class="indicador">
              <span><strong>Modelo: </strong></span>
              <div class="nowrap_space">{{modelo}}</div>
            </div>
            <div class="indicador">
              <span><strong>Marca: </strong></span>
              <div class="nowrap_space">{{marca}}</div>
            </div>
            <div class="indicador">
              <span><strong>NroPaquetes: </strong></span>
              <div>{{nro_paquetes}}</div>
            </div>
            <div class="indicador">
              <span><strong>NroPolos: </strong></span>
              <div>{{nro_polos}}</div>
            </div>
            <div class="indicador">
              <span><strong>NroPersonal: </strong></span>
              <div>{{nro_personal}}</div>
            </div>
            <div class="indicador">
              <span><strong>TipoEstampado: </strong></span>
              <div class="nowrap_space">{{tipo_estampado}}</div>
            </div>
            <div class="indicador">
              <span><strong>Cliente: </strong></span>
              <div class="nowrap_space">{{cliente}}</div>
            </div>
            <div class="indicador">
              <span><strong>Estado: </strong></span>
              <div>
                {{estado}}
              </div>
            </div>
            <div class="indicador">
              <span><strong>Avance: </strong></span>
              <div>{{avance}}</div>
            </div>
          </div>
          <div class="indicador">
            <span><strong>Observaciones: </strong></span>
            <div>{{observaciones}}</div>
          </div>
        </div>
      </div>
    </div>
  {{/each}}
</div>