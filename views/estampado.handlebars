<style>
  :root{
    font-size: 12px;
    font-family: Arial, Helvetica, sans-serif;
  }
  .cuerpo_estampado{
    width: 100%;
    height: 200px;
    border:1px solid red;
    border-radius: 20px;
    background-color: rgba(204, 204, 204, 0.5);
    margin-bottom: 10px;
  }
  .main{
    padding:10px;
  }
</style>
<div class="main">
  <h2>Informe estampado día {{fecha}}</h2>
  {{#each detalle}}
    <div class="cuerpo_estampado">
      <span style="font-size: .8rem;font-weight:600;">Modelo:</span>
      <div>Estampado {{@index}} {{modelo}}</div>      
    </div>
  {{/each}}
</div>