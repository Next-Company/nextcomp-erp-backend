<style>
  :root{
    font-size: 12px;
    font-family: Arial, Helvetica, sans-serif;
  }
  .cuerpo_estampado{
    width: 100%;
    /*height: 200px;*/
    border:1px solid gray;
    border-radius: 10px;
    background-color: rgba(241, 241, 241, 0.5);
    margin-bottom: 10px;
    position: relative;
  }
  .main_informe{
    padding:20px;
    width: 21cm;
    height: 20.7cm;
  }
  .main_informe h2{
    color: red;
  }
  .indice_estampado{
    position: absolute;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 50%;
    width: 25px;
    height: 25px;
    left: -15px;
    top: -5px;
    background-color: white;
    border: 0.2px solid black;
  }
</style>
<div class="main_informe">
  {{!-- <h2>Informe estampado</h2> --}}
  <h2>Informe estampado día {{fecha}}</h2>
  {{#each detalle}}
    <div class="cuerpo_estampado">
      <div class="indice_estampado">{{@index}}</div>
      <div style="padding:10px;">
        <span style="font-size: .8rem;font-weight:600;">Modelo:{{modelo}}</span>
        <br/>
        <br/>
        <div style="display:flex;gap:10px;">
          <div>
            <div><strong>NroPolos: </strong>{{nro_polos}}</div>
            <div><strong>NroPaquetes: </strong>{{nro_paquetes}}</div>
            <div><strong>NroPersonal: </strong>{{nro_personal}}</div>
            <div><strong>TipoEstampado: </strong>{{tipo_estampado}}</div>  
            <div><strong>Cliente: </strong>{{cliente}}</div>
            <div><strong>Estado: </strong>{{estado}}</div>
            <div><strong>Avance: </strong>{{estado}}</div>
            <div><strong>Observaciones: </strong>{{observaciones}}</div>
          </div>
          <div>
            
          </div>
        </div>
      </div>
    </div>
  {{/each}}
</div>