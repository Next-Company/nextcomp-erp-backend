{{!-- css-tokens.handlebars - ESTILOS BASE ESTANDARIZADOS (Senior) --}}
<style>
  :root {
    font-size: 11.5px;
    font-family: Arial, Helvetica, sans-serif;

    --font-small: 0.85rem;
    --font-normal: 0.95rem;
    --font-title: 1.1rem;

    --primary-blue: #b4c7e7;
    --border-color: #000000;
    --text-color: #000000;
    --bg-soft: #f9f9f9;
    --dashed-color: #999999;

    --padding-main: 0.2cm 0.0cm;
    --gap-section: 12px;
    --border-width: 1px;
  }

  body {
    padding: 0;
    margin: 0;
  }

  .main_informe {
    display: block;
    padding: var(--padding-main);
    box-sizing: border-box;
    color: var(--text-color);
    width: 100%;
  }

  /* Footer fijo al fondo, siempre visible */
  .last-page-footer {
  margin-top: 24px;
  padding: 0 10px;
  font-size: 0.75rem;
  color: #333;
}

  /* Bloque blanco que tapa el footer en páginas intermedias.
     En la última página el contenido lo empuja fuera y el footer queda visible */
  .footer-blocker {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 320px; /* ajusta al alto real de tu footer */
    background: #fff;
    z-index: 2;
  }

  /* Espacio al final del contenido para que no quede tapado por el footer */
  .footer-spacer {
    height: 340px; /* un poco más que el footer-blocker */
  }

  .table-guia {
    border-collapse: collapse;
    width: 100%;
    page-break-inside: auto;
    margin: 8px 0;
  }

  .table-guia th,
  .table-guia td {
    border: var(--border-width) solid var(--border-color);
    padding: 5px 6px;
    font-size: var(--font-small);
    line-height: 1.25;
    vertical-align: middle;
  }

  .table-guia thead th {
    background-color: var(--primary-blue);
    font-weight: bold;
    text-align: center;
    border-bottom: 2px solid var(--border-color);
  }

  .table-guia tfoot td {
    font-weight: bold;
    border-top: 2px solid var(--border-color);
  }

  @page {
    size: A4 portrait;
    margin: 10mm;
  }

  tr {
    page-break-inside: avoid;
    page-break-after: auto;
  }

  thead {
    display: table-header-group;
  }

  tfoot {
    display: table-footer-group;
  }

  .datos-proveedor-section {
    border-top: 0.5px dashed var(--dashed-color);
    font-size: var(--font-small);
    line-height: 1.45;
    padding: 9px 10px;
    margin: 10px 0;
  }

  .datos-proveedor-section.traslado {
    margin-top: 8px;
  }

  .datos-proveedor-section.servicio {
    border-top: none;
    margin-top: -4px;
  }

  .datos-orden-section {
    font-size: var(--font-small);
    line-height: 1.45;
    padding: 9px 10px;
    margin: 6px 0 10px 0;
  }

  .section-title {
    font-size: var(--font-title);
    font-weight: bold;
    margin: 12px 0 6px 0;
    padding-bottom: 4px;
  }

  .page-break {
    page-break-after: always;
  }

  .table-clean {
    width: 100%;
    border-collapse: collapse;
    margin: 8px 0;
    font-size: var(--font-small);
  }

  .table-clean th, .table-clean td {
    padding: 4px 6px;
    border-bottom: 1px solid #e5e5e5;
  }

  .table-clean thead th {
    font-weight: bold;
    border-bottom: 1.5px solid #000;
    text-align: center;
  }

  .table-clean tfoot td {
    padding: 6px 5px;
    border-top: 1.5px solid #000;
    font-weight: bold;
  }

  .text-right { text-align: right; }
  .text-center { text-align: center; }
  .text-left { text-align: left; }
</style>