{{!-- document-header.handlebars --}}
<table style="width:100%; border-collapse:collapse; border:none;">
  <tbody>
    <tr style="vertical-align:top;">

      <!-- BLOQUE IZQUIERDO: LOGO + DATOS EMPRESA + FECHAS -->
      <td style="width:55%; padding:8px 5px;">
        <table style="width:100%; font-size:10px; border-collapse:collapse;">
          <tbody>
            <tr>
              <td colspan="2" style="text-align:center; padding-bottom:6px;">
                <img src="http://192.168.18.20:5173/images/logo_next-02.jpg"
                     style="width:240px; max-width:100%; height:auto;"
                     alt="NEXT COMPANY S.A.C" />
              </td>
            </tr>
            <tr>
              <td colspan="2" style="line-height:1.45; padding-bottom:14px; text-align:center;">
                Calle Felipe Santiago Crespo Nro 581 - San Luis - Lima<br/>
                {{!-- R.U.C. 20522094120<br/> --}}
                Telf: 3233128<br/>
                <strong>next.company.sac@gmail.com</strong>
              </td>
            </tr>

            {{#if documentDeliveryDate}}
            <tr>
              <td style="padding:0 3px 0 0; width:50%;">
                <table style="border-collapse:separate; border-spacing:0; width:100%; border:1px solid black; border-radius:6px; overflow:hidden;">
                  <tbody>
                    <tr>
                      <td style="padding:6px 10px; white-space:nowrap;">
                        <span style="font-size:8px; color:#555;">Fecha de emisión: </span>
                        <span style="font-size:12px; font-weight:bold;">{{documentDate}}</span>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </td>
              <td style="padding:0 0 0 3px; width:50%;">
                <table style="border-collapse:separate; border-spacing:0; width:100%; border:1px solid black; border-radius:6px; overflow:hidden;">
                  <tbody>
                    <tr>
                      <td style="padding:6px 10px; white-space:nowrap;">
                        <span style="font-size:8px; color:#555;">Fecha de retorno: </span>
                        <span style="font-size:12px; font-weight:bold;">{{documentDeliveryDate}}</span>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </td>
            </tr>
            {{else}}
            <tr>
              <td style="padding:0 3px 0 0; width:50%;">
                <table style="border-collapse:separate; border-spacing:0; width:60%; border:1px solid black; border-radius:6px; overflow:hidden;">
                <tbody>
                  <tr>
                    <td style="padding:6px 10px; white-space:nowrap;">
                      {{#if documentDeliveryDate}}
                        <span style="font-size:8px; color:#555;">Fecha de entrega: </span>
                        <span style="font-size:12px; font-weight:bold;">{{documentDeliveryDate}}</span>
                      {{else}}
                        <span style="font-size:8px; color:#555;">Fecha de retorno: </span>
                        <span style="font-size:12px; font-weight:bold;">{{documentReturnDate}}</span>
                      {{/if}}
                    </td>
                  </tr>
                </tbody>
              </table>
              </td>
              <td style="padding:0 3px 0 0; width:50%;">
                <table style="border-collapse:separate; border-spacing:0; width:60%; border:1px solid black; border-radius:6px; overflow:hidden;">
                  <tbody>
                    <tr>
                      <td style="padding:6px 10px; white-space:nowrap;">
                        <span style="font-size:8px; color:#555;">Fecha de emisión: </span>
                        <span style="font-size:12px; font-weight:bold;">{{documentDate}}</span>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </td>
            </tr>
            
            
            {{/if}}

          </tbody>
        </table>
      </td>

      <!-- BLOQUE DERECHO: forzamos altura con div wrapper -->
      <td style="width:45%; padding:8px 5px;">
        <div style="
          border:1px solid black;
          border-radius:8px;
          overflow:hidden;
          display:flex;
          flex-direction:column;
          min-height:133px;
          height:100%;
        ">
          <!-- RUC -->
          <div style="
            font-size:12px;
            text-align:center;
            padding:6px 8px;
            border-bottom:1px solid black;
            color:#555;
          ">
            R.U.C. 20522094120
          </div>

          <!-- TÍTULO -->
          <div style="
            font-weight:bold;
            font-size:14px;
            text-align:center;
            padding:0 8px;
            background-color:#eef0f3;
            border-bottom:1px solid black;
            flex:1;
            display:flex;
            align-items:center;
            justify-content:center;
          ">
            {{documentTitle}}
          </div>

          <!-- NÚMERO -->
          <div style="
            font-size:11px;
            text-align:center;
            padding:0 8px;
            flex:1;
            display:flex;
            align-items:center;
            justify-content:center;
          ">
            <strong style="font-size:18px; margin-left:6px;">{{documentNumber}}</strong>
          </div>
        </div>
      </td>

    </tr>
  </tbody>
</table>