<style>
  @media print{
    div.main_informe.change_color{
      color:'red'
    }
  }
  :root{
    --color: #000000;
    font-size: 14px;
    font-family: Arial, Helvetica, sans-serif;
    --background-color: rgb(255, 241, 221);
  }
  .main_informe{
    /*padding:0.2cm;*/
    display: flex;
    flex-direction: row;
    height: 196mm;
  }
  .main_informe h2{
    font-size: 1.2rem;
  }
  .indice_estampado{
    position: absolute;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 50%;
    width: 25px;
    height: 25px;
    left: -15px;
    top: -10px;
    background-color: white;
    border: 0.2px solid black;
  }
  .indicador{
    flex:1;
  }
  .nowrap_space{
    white-space: nowrap;
  }
</style>
