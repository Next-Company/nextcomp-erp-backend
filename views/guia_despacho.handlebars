              {{!-- <th style="text-align:center;">Incompletos</th> --}}
            </tr>
          </thead>
          <tbody>
            {{#each detalle}}
              <tr style="">
                <td style="text-align: center;width:.5cm;">{{plusindex @index}}</td>
                <td style="font-weight: bold;">{{articulo}}</td>
                <td></td>
                <td style="width:60px;text-align: center;">{{cantidad}}</td>
                {{#each fracciones_despacho_cantidad}}
                  <td style="text-align: center;font-weight: bold;">{{this}}</td>
                {{/each}}
                {{!-- <td style="text-align: center;font-weight: bold;">{{xs}}</td>
                <td style="text-align: center;font-weight: bold;">{{s}}</td>
                <td style="text-align: center;font-weight: bold;">{{m}}</td>
                <td style="text-align: center;font-weight: bold;">{{l}}</td>
                <td style="text-align: center;font-weight: bold;">{{xl}}</td>
                <td style="text-align: center;font-weight: bold;">{{xxl}}</td> --}}
                <td style="width:1.5px;text-align: center;">NIU</td>
                <td style="width:60px;text-align: center;">{{despacho}}</td>
                <td style="width:60px;text-align: center;">{{incompletos}}</td>
                <td style="width:60px;text-align: center;">{{caidos}}</td>
              </tr>
            {{/each}}
