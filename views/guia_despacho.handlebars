<style>
  @media print{
    div.main_informe.change_color{
      color:'red'
    }
  }
  :root{
    --color: #000000;
    font-size: 10px;
    font-family: Arial, Helvetica, sans-serif;
    background-color: rgb(255, 241, 221);
  }
  .main_informe{
    /*padding:0.2cm;*/
    display: flex;
    flex-direction: row;
  }
  .main_informe h2{
    font-size: 1.2rem;
  }
  .indice_estampado{
    position: absolute;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 50%;
    width: 25px;
    height: 25px;
    left: -15px;
    top: -10px;
    background-color: white;
    border: 0.2px solid black;
  }
  .indicador{
    flex:1;
  }
  .nowrap_space{
    white-space: nowrap;
  }
</style>
<div class="main_informe" style="color:{{color}}">
  <div style="flex:1;padding:5px;display:flex;flex-direction:column;">
    <section style="display:none;>
      <div style="border-radius:10px;border:1px solid blue;">
      	<div>
	  <div sytle="border:1px solid blue;">
	    GUIA DE REMISION 
	  <div>
	  <div></div>
	</div>
	<div></div>
      </div>
    </section>

    <section style="flex:1;">
      <br/>
      <br/>
      <br/>
      <br/>
      <br/>
      <br/>
      <p style="font-size: 1.2rem;font-weight:600;text-align:center;">
        NEXT COMPANY S.A.C<br/>
        NEXT
      </p>
      <section style="font-size:.8rem;border-bottom:.5px dashed black;text-align:center;">
        <p>
          DOMICILIO FISCAL: CAL.FELIPE SANTIAGO CRESPO NRO. 581 LIMA - LIMA - SAN LUIS, RUC: 20522094120<br/>
        </p>
      </section>
      <p style="font-size: 1.1rem;font-weight:bolder;text-align:center;">
        GUIA DE INGRESO INTERNOs<br/>
        {{idguia}}
      </p>
      <section style="display: flex;justify-content:space-between;border-bottom:.5px dashed black;padding-bottom: 10px;">
        <div style="font-size: .9rem;text-align:center;">
          <strong>FECHA DE EMISIÓN:</strong> {{cabecera.fec_emision_guia}}
        </div>
        <div style="font-size: .9rem;text-align:center;">
          <strong>HORA DE EMISIÓN:</strong> {{time}}
        </div>
        <div style="font-size: .9rem;text-align:center;">
          <strong>FECHA DE RETORNO:</strong> {{cabecera.fec_retorno_guia}}
        </div>
        <div style="font-size: .9rem;text-align:center;">
          <strong>DÍAS PRODUCCIÓN:</strong> {{cabecera.duracion}}
        </div>
      </section>
      <p style="font-size: 1.1rem;font-weight:bolder;">
        DATOS DEL DESTINATARIO:<br/>
      </p>
      <section style="border-bottom:.5px dashed black;font-size:.9rem;padding-bottom: 10px;">
        <table>
          <tbody>
            <tr>
              <td>Señor(es):</td>
              <td style="width: 300px;">{{proveedor.nom}}</td>
              <td>RUC:</td>
              <td>{{proveedor.ruc}}</td>
            </tr>
            <tr>
              <td>Punto de Partida :</td>
              <td>CAL FELIPE SANTIAGO CRESPO NRO. 581 LIMA-SAN LUIS LIMA</td>
              <td>Punto de Llegada :</td>
              <td>{{proveedor.direccion}}</td>
            </tr>
          </tbody>
        </table>
      </section>
      <p style="font-size: 1.1rem;font-weight:bold;">
        DATOS DE BIENES:<br/>
      </p>
      <section style="border-bottom:.5px dashed black;padding-bottom:10px;font-size:.9rem; display:flex;justify-content:space-between;">
        <table>
          <tbody>
            <tr>
              <td>Modelo:</td>
              <td style="width: 300px;">{{cabecera.modelo}}</td>
              <td>Precio:</td>
              <td>S/.{{cabecera.costo}}</td>
            </tr>
            <tr>
              <td>Descripción:</td>
              <td>{{cabecera.producto}}</td>
              <td>OP/Corte:</td>
              <td>#{{cabecera.orden_ref}}</td>
            </tr>
          </tbody>
        </table>
      </section>
      <p style="font-size: 1.1rem;font-weight:bold;">
        RESUMEN DETALLE:<br/>
      </p>
      <section style="font-size:.9rem; padding-bottom: 10px;">
        <table style="border-collapse: collapse;width:100%;">
          <thead>
            <tr style="border-bottom:.2px solid gray;">
              <th>#</th>
              <th style="text-align:left;">Artículos de producción</th>
              <th style="text-align:center;">XS/26</th>
              <th style="text-align:center;">S/28</th>
              <th style="text-align:center;">M/30</th>
              <th style="text-align:center;">L/32</th>
              <th style="text-align:center;">XL/34</th>
              <th style="text-align:center;">XXL/36</th>
              <th style="text-align:center;">UM</th>
              <th style="text-align:center;">Cantidad</th>
              <th style="text-align:center;">Ingreso</th>
              <th style="text-align:center;">Caidos</th>
              <th style="text-align:center;">Incompletos</th>
            </tr>
          </thead>
          <tbody>
            {{#each detalle}}
              <tr style="">
                <td style="text-align: center;width:.5cm;">{{plusindex @index}}</td>
                <td>{{articulo}}</td>
                <td style="text-align: center;">{{xs}}</td>
                <td style="text-align: center;">{{s}}</td>
                <td style="text-align: center;">{{m}}</td>
                <td style="text-align: center;">{{l}}</td>
                <td style="text-align: center;">{{xl}}</td>
                <td style="text-align: center;">{{xxl}}</td>
                <td style="width:1.5px;text-align: center;">NIU</td>
                <td style="width:80px;text-align: center;">{{cantidad}}</td>
                <td style="width:40px;text-align: center;">{{despacho}}</td>
                <td style="width:40px;text-align: center;">{{caidos}}</td>
                <td style="width:40px;text-align: center;">{{incompletos}}</td>
              </tr>
            {{/each}}
            <tfoot>
              <tr>
                <td colspan="8"></td>
                <td style="text-align: center;font-size:.9rem;"><strong>Total</strong></td>
                <td style="text-align: center;font-size:.9rem;"><strong>{{totalunid}}</strong></td>
                <td style="text-align: center;font-size:.9rem;"><strong>{{totaldespacho}}</strong></td>
                <td style="text-align: center;font-size:.9rem;"><strong>{{totalcaidos}}</strong></td>
                <td style="text-align: center;font-size:.9rem;"><strong>{{totalincompletos}}</strong></td>
              </tr>
            </tfoot>
          </tbody>
        </table>
      </section>
      {{!-- </br> --}}
      {{#if numproto}}
      <section style="font-size:.9rem;">
        <table style="border-collapse: collapse;width:100%;">
          <thead>
            <tr style="border-bottom: .2px solid gray;">
              <th>#</th>
              <th style="text-align:left;">Adicionales</th>
              <th style="text-align:center;"></th>
              <th style="text-align:center;"></th>
              <th style="text-align:center;"></th>
              <th style="text-align:center;"></th>
              <th style="text-align:center;"></th>
              <th style="text-align:center;"></th>
              <th style="width:1.5cm;text-align:center;"></th>
              <th style="width:1.5cm;text-align:center;">Cantidad</th>
              <th style="width:1.5cm;text-align:center;">Ingresos</th>
              <th style="width:1.5cm;text-align:center;">Saldo</th>
            </tr>
          </thead>
          <tbody>
            {{#each prototipos}}
            {{!-- <tr style="border-bottom: .2px solid gray;"> --}}
            <tr style="">
              <td style="text-align: center;width:.5cm;">{{plusindex @index}}</td>
              <td>{{articulo}}</td>
              <td style="text-align: center;"></td>
              <td style="text-align: center;"></td>
              <td style="text-align: center;"></td>
              <td style="text-align: center;"></td>
              <td style="text-align: center;"></td>
              <td style="text-align: center;"></td>
              <td style="text-align: center;"></td>
              <td style="text-align: center;">{{cantidad}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </section>
      {{/if}}
    </section>
    <footer>
      <section style="padding-top:50px;font-size:.9rem;">
        <strong>Condiciones de pagos:</strong> Las fechas de cierre son los días miércoles de cada semana. La programación de pagos variaran dependiendo de si los despachos fueron recepcionados antes o después de la fecha de cierre. Los proveedores cuyos despachos sean recibidos antes de la fecha de cierre(lunes, martes o miércoles), recibirán el pago en un plazo máximo de 10 días a partir de dicha fecha de cierre; por el contrario, los proveedores cuyos despachos sean recibidos después de la fecha de cierre(jueves, viernes o sábado), recibirán el pago en un plazo máximo de 10 días a partir de la fecha de cierre de la semana siguiente.<br/><br/>
        <strong>Penalidades :</strong> El despacho deberá ejecutarse segun las fechas indicadas en el presente documento, despues de la fecha de vencimineto se aplicará una penalidad sobre el valor costo de la OC: de 1 a 5 días de retraso la penalidad sera de <strong>5%</strong>, de 6 a 10 días la penalidad serea de <strong>10%</strong> y de 11 a 15 días sera <strong>%15</strong>, de 16 días a más se evaluará la recepción de la OC. El proveedor consignado en el presente documento autoriza a Next Company a retener de forma automática el pago de facturas del proveedor por el valor de lo adeudado.<br/><br/>
        <strong>Fecha/hora impresión: {{date}} {{time}}</strong><br/>
      </section>
    </footer>
  </div>
</div>
<div sytle="position:absolute;width:150px;height:150px;border-radius:50%;top:100px;left:100px;"></div>
<script>
  var r = document.querySelector(':root')
  var rs = getComputedStyle(r);
  r.style.setProperty('--color', '#000000');
</script>
