      <div style="font-weight:bolder;text-align:center;border-bottom:1.5px solid black;border-top:1.5px solid black;padding:8px 0px;position:relative;display:flex;flex-direction:row;justify-content:space-between;align-items:center;">
        <div style="font-size:1.8rem;display:flex;gap:10px;align-items:center;">
          {{!-- <img src="data:image/jpg;base64,{{this.BINARY_CHUNKS}}" class="logo" style="width:30px;"> --}}
          {{!-- <div style="width: 10px; height:20px; background-color:black;"></div> --}}
