      {{/if}}
    </section>
    <footer>
      <section style="display:flex;justify-content:space-around;gap:15px;">
        <div style="border-top:.5px dashed black;padding:5px;text-align:center;flex:1;font-size:.9rem;">
          Asistente almacén
          <div style="text-align:left;height:30px;border-bottom:.5px dotted gray;display:flex;align-items:center;">Nom:</div>
        </div>
        <div style="border-top:.5px dashed black;padding:5px;text-align:center;flex:1;font-size:.9rem;">
          Control de ingreso
