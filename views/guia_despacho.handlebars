{{!-- guia_despacho.handlebars --}}

{{#> guia-ingreso}}

<p style="font-size:0.75rem;font-weight:bold;margin-bottom:3px;">
  RESUMEN DETALLE:
</p>

<section style="padding-bottom:6px;">

  <table style="
    border-collapse:collapse;
    width:100%;
    font-size:0.7rem;
    line-height:1.1;
  ">

    <!-- HEADER -->
    <thead>
      <tr style="border-bottom:1px solid #000;">
        <th style="width:3%;">#</th>
        <th style="text-align:left;">Artículos de producción</th>
        <th style="width:45px;"></th>
        <th style="text-align:center;">Qty</th>

        {{#each tallasbase}}
          <th style="
            text-align:center;
            width:20px;
            font-weight:bold;
          ">
            {{this}}
          </th>
        {{/each}}

        <th style="text-align:center;">UM</th>
        <th style="text-align:center;">Ing.</th>
        <th style="text-align:center;">Icp.</th>
        <th style="text-align:center;">Cdo.</th>
      </tr>
    </thead>

    <!-- BODY -->
    <tbody>
      {{#each detalle}}
        <tr>
          <td style="text-align:center;">
            {{plusindex @index}}
          </td>

          <td style="padding-left:2px;">
            {{articulo}}
          </td>

          <td></td>

          <td style="text-align:center;">
            {{cantidad}}
          </td>

          {{#each fracciones_despacho_cantidad}}
            <td style="
              text-align:center;
              font-weight:bold;
            ">
              {{this}}
            </td>
          {{/each}}

          <td style="text-align:center;">NIU</td>
          <td style="text-align:center;">{{despacho}}</td>
          <td style="text-align:center;">{{incompletos}}</td>
          <td style="text-align:center;">{{caidos}}</td>
        </tr>
      {{/each}}
    </tbody>

    <!-- FOOTER -->
    <tfoot>
      <tr style="border-top:1px solid #000;">
        <td colspan="3"></td>

        <td style="text-align:center;font-weight:bold;">
          {{totalunid}}
        </td>

        <td colspan="{{colspantallas}}"></td>

        <td style="text-align:center;font-weight:bold;">
          {{totaldespacho}}
        </td>

        <td style="text-align:center;font-weight:bold;">
          {{totalincompletos}}
        </td>

        <td style="text-align:center;font-weight:bold;">
          {{totalcaidos}}
        </td>
      </tr>
    </tfoot>

  </table>

</section>

{{#if numproto}}
<section style="margin-top:5px;">

  <table style="
    border-collapse:collapse;
    width:100%;
    font-size:0.7rem;
  ">

    <thead>
      <tr style="border-bottom:1px solid #000;">
        <th style="width:3%;">#</th>
        <th style="text-align:left;">Adicionales</th>
        <th style="text-align:center;width:50px;">Cant.</th>
      </tr>
    </thead>

    <tbody>
      {{#each prototipos}}
        <tr>
          <td style="text-align:center;">
            {{plusindex @index}}
          </td>

          <td style="padding-left:2px;">
            {{articulo}}
          </td>

          <td style="text-align:center;">
            {{cantidad}}
          </td>
        </tr>
      {{/each}}
    </tbody>

  </table>

</section>
{{/if}}

{{/guia-ingreso}}