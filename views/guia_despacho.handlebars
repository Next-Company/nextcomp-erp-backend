      {{!-- <p style="font-size: 1.1rem;font-weight:bolder;text-align:center;border-bottom:.5px dashed black;padding-bottom:10px;position:relative;">
        GUIA DE INGRESO INTERNO / {{idguia}}<br/>
        <div style="position: absolute;top:0px;left:0px;">
          <img src="data:image/jpg;base64,{{this.BINARY_CHUNKS}}" class="logo" style="width:30px;">
