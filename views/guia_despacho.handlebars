        </div>
        <div style="font-size: .9rem;text-align:center;">
          <strong>HORA DE EMISIÓN:</strong> {{time}}
        </div>
      </section> --}}
      <p style="font-size: .9rem;font-weight:bolder;">
        DATOS DEL INGRESO:<br/>
      </p>
      <section style="border-bottom:.5px dashed black;font-size:.9rem;padding-bottom: 10px;">
        <table>
          <tbody>
            <tr>
              <td>Proveedor:</td>
              <td style="width: 500px;">{{proveedor.nom}}</td>
              <td>Contacto:</td>
              <td style="width: 200px;">{{cabecera.responsable}}</td>
              <td>#GuiaRef:</td>
              <td>{{idref}}</td>
            </tr>
          </tbody>
        </table>
      </section>
      {{!-- <section style="border-bottom:.5px dashed black;font-size:.9rem;padding-bottom: 10px;">
        <table>
          <tbody>
            <tr>
              <td>Señor(es):</td>
              <td style="width: 300px;">{{proveedor.nom}}</td>
              <td>RUC:</td>
              <td>{{proveedor.ruc}}</td>
            </tr>
            <tr>
              <td>Punto de Partida :</td>
