{{#> guia-ingreso}}

  {{!-- Título con orden y número de guía --}}
  {{!-- <div style="font-weight:bolder;text-align:center;border-bottom:1.5px solid black;border-top:1.5px solid black;padding:8px 0px;display:flex;justify-content:space-between;align-items:center;">
    <div style="font-size:1.8rem;">GUIA DE INGRESO</div>
    <div style="display:flex;gap:20px;">
      <div style="display:flex;flex-direction:column;">
        <div style="font-size:10px;"># ORDEN</div>
        <div style="font-size:1.5rem;">{{cabecera.orden_ref}}</div>
      </div>
      <div style="display:flex;flex-direction:column;">
        <div style="font-size:10px;"># GUIA</div>
        <div style="font-size:1.5rem;">{{idguia}}</div>
      </div>
    </div>
  </div> --}}

  {{!-- Tabla de detalle con tallas dinámicas --}}
  <p style="font-size:.9rem;font-weight:bold;">RESUMEN DETALLE:</p>
  <section style="font-size:.9rem;padding-bottom:10px;">
    <table style="border-collapse:collapse;width:100%;">
      <thead>
        <tr style="border-bottom:.2px solid gray;">
          <th>#</th>
          <th style="text-align:left;">Artículos de producción</th>
          <th style="text-align:right;width:100px;"></th>
          <th style="text-align:center;">Qty</th>
          {{#each tallasbase}}
            <th style="text-align:center;width:30px;">{{this}}</th>
          {{/each}}
          <th style="text-align:center;">UM</th>
          <th style="text-align:center;">Ing.</th>
          <th style="text-align:center;">Icp.</th>
          <th style="text-align:center;">Cdo.</th>
        </tr>
      </thead>
      <tbody>
        {{#each detalle}}
          <tr>
            <td style="text-align:center;width:.5cm;">{{plusindex @index}}</td>
            <td style="font-weight:bold;">{{articulo}}</td>
            <td></td>
            <td style="text-align:center;">{{cantidad}}</td>
            {{#each fracciones_despacho_cantidad}}
              <td style="text-align:center;font-weight:bold;">{{this}}</td>
            {{/each}}
            <td style="text-align:center;">NIU</td>
            <td style="text-align:center;">{{despacho}}</td>
            <td style="text-align:center;">{{incompletos}}</td>
            <td style="text-align:center;">{{caidos}}</td>
          </tr>
        {{/each}}
      </tbody>
      <tfoot>
        <tr>
          <td colspan="3"></td>
          <td style="text-align:center;"><strong>{{totalunid}}</strong></td>
          <td colspan="{{colspantallas}}"></td>
          <td style="text-align:center;"><strong>{{totaldespacho}}</strong></td>
          <td style="text-align:center;"><strong>{{totalincompletos}}</strong></td>
          <td style="text-align:center;"><strong>{{totalcaidos}}</strong></td>
        </tr>
      </tfoot>
    </table>
  </section>

  {{!-- Adicionales si existen --}}
  {{#if numproto}}
    <section style="font-size:.9rem;">
      <table style="border-collapse:collapse;width:100%;">
        <thead>
          <tr style="border-bottom:.2px solid gray;">
            <th>#</th>
            <th style="text-align:left;">Adicionales</th>
            <th style="text-align:center;">Cantidad</th>
          </tr>
        </thead>
        <tbody>
          {{#each prototipos}}
            <tr>
              <td style="text-align:center;width:.5cm;">{{plusindex @index}}</td>
              <td>{{articulo}}</td>
              <td style="text-align:center;">{{cantidad}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </section>
  {{/if}}

{{/guia-ingreso}}