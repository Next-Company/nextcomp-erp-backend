{{!-- guia_back.handlebars --}}

{{#> guia-ingreso}}

<style>
  .main_content {
    color: {{color}};
    font-family: Arial, sans-serif;
    font-size: 0.75rem;
    line-height: 1.2;
  }

  .table {
    width: 100%;
    border-collapse: collapse;
  }

  .table th,
  .table td {
    padding: 3px 5px;
    border-bottom: 1px solid #e5e5e5;
  }

  .table thead th {
    font-weight: bold;
    border-bottom: 1.5px solid #999;
  }

  /* 🔥 QUITA LOS GUIONES DEL FOOTER */
  .table tfoot td {
    padding: 4px 5px;
    border: none;
    font-weight: bold;
  }

  /* opcional: quitar también última línea del body */
  .table tbody tr:last-child td {
    border-bottom: none;
  }

  .text-center {
    text-align: center;
  }

  .text-right {
    text-align: right;
  }

  .text-left {
    text-align: left;
  }

  .section-title {
    font-size: 0.8rem;
    font-weight: bold;
    margin-bottom: 4px;
  }

  section {
    margin-top: 10px;
  }
</style>

<div class="main_content">

  {{> datos-proveedor-servicio}}

  <!-- TABLA A TRANSPORTAR -->
  <section>

    <p class="section-title">A TRANSPORTAR:</p>

    <table class="table">
      <thead>
        <tr>
          <th class="text-center" style="width:4%;">#</th>
          <th class="text-left">Artículos de producción</th>

          {{#header tallas}}
          {{/header}}

          <th class="text-center">UM</th>
          <th class="text-center">Cant.</th>
          <th class="text-center" style="width:60px;">Costo</th>
          <th class="text-center">Importe</th>
        </tr>
      </thead>

      <tbody>
        {{#cuerpo detalle tallas}}
        {{/cuerpo}}
      </tbody>

      <tfoot>
        <tr>
          <td colspan="{{colspantotales}}"></td>
          <td class="text-right">Total</td>
          <td class="text-center">{{totalunid}}</td>
          <td class="text-right">Subtotal</td>
          <td class="text-center">{{totalimporte}}</td>
        </tr>
        <tr>
          <td colspan="{{colspantotales}}"></td>
          <td></td>
          <td></td>
          <td class="text-right">IGV</td>
          <td class="text-center">{{valor_igv}}</td>
        </tr>
        <tr>
          <td colspan="{{colspantotales}}"></td>
          <td></td>
          <td></td>
          <td class="text-right">TOTAL</td>
          <td class="text-center">{{importetotal}}</td>
        </tr>
      </tfoot>
    </table>

  </section>

  <!-- ADICIONALES -->
  {{#if numproto}}
  <section>

    <p class="section-title">ADICIONALES:</p>

    <table class="table">
      <thead>
        <tr>
          <th style="width:4%;">#</th>
          <th class="text-left">Descripción</th>
          <th colspan="8"></th>
          <th class="text-center">Cant.</th>
        </tr>
      </thead>

      <tbody>
        {{#each prototipos}}
        <tr>
          <td class="text-center">{{plusindex @index}}</td>
          <td>{{articulo}}</td>
          <td colspan="8"></td>
          <td class="text-center">{{cantidad}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>

  </section>
  {{/if}}

</div>

{{/guia-ingreso}}