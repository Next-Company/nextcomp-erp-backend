          <strong>FECHA DE EMISION:</strong> {{date}}
        </div>
        <div style="font-size: .9rem;text-align:center;">
          <strong>HORA DE EMISION:</strong> {{time}}
        </div>
      </section>
      <p style="font-size: 1.1rem;font-weight:bolder;">
        DATOS DEL DESTINATARIO<br/>
      </p>
      <section style="border-bottom:.5px dashed black;font-size:.8rem;padding-bottom: 10px;">
        <table>
          <tbody>
            <tr>
              <td>Seño(es):</td>
              <td>NEXT COMPANY SAC</td>
            </tr>
            <tr>
              <td>RUC:</td>
              <td>20522094120</td>
            </tr>
            <tr>
              <td>Punto de Partida :</td>
              <td>AV LURIGANCHO 1349 URB.IND ZARATE</td>
            </tr>
            <tr>
              <td>Destino: </td>
              <td>P17672 - NEXT COMPANY SAC</td>
            </tr>
            <tr>
              <td>Punto de Llegada :</td>
              <td>CAL FELIPE SANTIAGO CRESPO NRO. 581 LIMA-SAN LUIS LIMA</td>
            </tr>
          </tbody>
        </table>
      </section>
      <p style="font-size: 1.1rem;font-weight:bold;">
        DATOS DEL TRANSPORTE<br/>
      </p>
      <section style="display: flex;justify-content:space-between;border-bottom:.5px dashed black;padding-bottom:10px;font-size:.8rem;">
        <div>
          Fecha de inicio del traslado: 23/01/2025
        </div>
        <div>
          Modalidad: Transporte Privado
        </div>
      </section>
      <p style="font-size: 1.1rem;font-weight:bold;">
        TIPO Y MOTIVO DE TRASLADO<br/>
      </p>
      <section style="border-bottom:.5px dashed black;padding-bottom:10px;font-size:.8rem;">
        <div>
          Tipo de Traslado: TRASLADO DE MUESTRAS A PROVEEDOR
        </div>
        <div>
          Motivo de Traslado: PROVEEDOR P17672 - NEXT COMPANY SAC
        </div>
      </section>
      <p style="font-size: 1.1rem;font-weight:bold;">
        DATOS DE BIENES A TRANSPORTAR<br/>
      </p>
      <section style="border-bottom:.5px dashed black;font-size:.8rem; padding-bottom: 10px;">
        <table>
          <thead>
            <tr>
              <th>Id</th>
              <th style="width:20cm;text-align:left; ">Descripcion</th>
              <th>OP</th>
              <th>UM</th>
              <th>Cantidad</th>
            </tr>
          </thead>
          <tbody>
            {{#each detalle}}
            <tr>
              <td>{{idx}}</td>
              <td>{{articulo}}</td>
              <td>2410565</td>
              <td>NIU</td>
              <td>{{cantidad}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </section>
      <section style="padding-top:10px;">
        <strong>Total unidades : 2</strong>
      </section>
    </section>
    <footer>
      <section style="display:flex;justify-content:space-around;gap:15px;">
        <div style="border-top:.5px dashed black;padding:5px;text-align:center;flex:1;font-size:.8rem;">Entregué conforme</div>
        <div style="border-top:.5px dashed black;padding:5px;text-align:center;flex:1;font-size:.8rem;">Lleve conforme</div>
        <div style="border-top:.5px dashed black;padding:5px;text-align:center;flex:1;font-size:.8rem;">Recibí conforme</div>
      </section>
      <section style="padding-top:50px;font-size:.9rem;">
        <strong>Observaciones:</strong> DEVOLUCION DE MUESTAS A PROVEEDOR<br/><br/>
        <strong>Representacion impresa de la Guia de Remision Electronica</strong><br/>
        <strong>Autorizado mediante Resolucion de Superintendencia Nro 0180050002070/SUNAT</strong><br/>
        <strong>Consulta web de este GRE: https://portal.efacturacion.pe/appefacturacion</strong><br/>
        <strong>Fecha/hora impresión: {{date}} {{time}}</strong><br/>
      </section>
    </footer>
  </div>
