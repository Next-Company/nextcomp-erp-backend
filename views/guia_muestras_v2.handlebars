                <td>{{articulo}}</td>
                <td style="text-align: center;">{{xs}}</td>
                <td style="text-align: center;">{{s}}</td>
                <td style="text-align: center;">{{m}}</td>
                <td style="text-align: center;">{{l}}</td>
