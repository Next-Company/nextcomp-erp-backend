<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    width: 100mm;
    height: 45mm;
  }

  .row {
    display: flex;
    justify-content: flex-start;
    width: 107.5mm;
    height: 45mm;
    gap: 2.5mm;
    overflow: hidden;
    break-after: page;
  }

  .etiqueta {
    background-color: white;
    font-size: .4rem;
    width: 33.5mm;
    height: 45mm;
    padding: 2mm;
    display: flex;
    flex-direction: row;
    gap: 1mm;
    position: relative;
    overflow: hidden;
  }

  /* Columna izquierda: texto + talla */
  .columna-texto {
    flex: 1.5;
    display: flex;
    flex-direction: column;
    gap: 1mm;
    overflow: hidden;
  }

  /* Columna derecha: solo barcode */
  .columna-barcode {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }

  .columna-barcode img {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(90deg);
    /* ORIGINAL (36mm rotado = ~18mm de ancho visual, invadía la columna de texto y tapaba el modelo):
    height: auto;
    width: 36mm; */
    width: 34mm;   /* largo del barcode: queda vertical tras rotar (buena longitud de escaneo) */
    height: 9mm;   /* ancho visual tras rotar: cabe dentro de su columna, ya no tapa el nombre */
  }

  h2 { font-size: .5rem; }
  h3 { font-size: .4rem; }

  #talla {
    font-size: 1.2rem;
    font-weight: bolder;
    text-align: center;
  }

  #idcodbar {
    font-size: 5px;
    letter-spacing: 5.5px;
    transform: scale(1, 0.8);
  }

  #footer-circles {
    display: flex;
    gap: 3px;
    width: 60px;
  }

  #footer-circles div:nth-child(2n-1) {
    background-color: black;
    border-radius: 100%;
    width: 4px;
    height: 4px;
  }

  #footer-circles div:nth-child(2n) {
    border-radius: 100%;
    width: 4px;
    height: 4px;
  }

  .bar {
    width: 2mm;
    background-color: black;
    position: absolute;
    left: -1mm;
    top: -10mm;
    height: 20mm;
  }

  .precio-valor {
  font-size: 13px;
  font-weight: bold;
  }
</style>

<body>
  {{#foo this.BASE this.INFO this.MONEDA this.ORDEN}}
  {{/foo}}
</body>
