<style>
  body{
    margin: 0px;
    padding: 0px;
  }
  :root{
    width: 297mm;
    height: 210mm;
    border: 0px solid orange;
    margin: 0px;
    padding: 0px;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 12px;
  }
  div.main{
    margin: 0px;
    width: 297mm;
    height: 210mm;
    border: 0px solid green;
    background-color: white;
    break-after: page;
  }
  #head{
    display: flex;
    flex-direction: row;
    height: 60px;
  }
  #head div{
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0px 20px;
  }
  #head div:first-child{
    width: 100px;
  }
  #head div:nth-child(2){
    border: 2px solid;
    flex:1;
  }
  #head div:nth-child(4){
    border:2px solid;
    width:150px;
  }
  #subhead{
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 28px;
    font-weight: bold;
    font-size: 12px;
    padding: 0px 15px;
  }
  #firmas_container{
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    height: 100px;
  }
  #firmas_container div{
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    text-align: center;
    height: 50px;
    width: 150px;
    border-top: 1px solid;
    font-weight: bold;
    font-style: italic;
  }
  table#sugerido{
    font-size: 12px;
    font-weight:bold;
  }
  table#sugerido th, td {
    border: 1px solid black;
  }
  table#sugerido{
    border-collapse: collapse;
    width: 100%;
  }
  table#liquidacion{
    border-collapse: collapse;
    border:2px solid;
  }
  table#liquidacion td,th{
    border:1px solid;
  }
  table#liquidacion thead tr{
    height: 45px;
    background-color: #b5e1ff;
    font-style: italic;
  }
  table#liquidacion tbody tr{
    height: 22px;
  }
  table#liquidacion tfoot tr:nth-child(1){
    height: 30px;
    text-align: center;
    font-size: 14px;
    font-weight: bolder;
    font-style: italic;
    background-color: yellow;
    border:2px solid;
  }
  table#liquidacion tfoot tr:nth-child(2){
    height: 100px;
  }
</style>
<div class="main">
  <div id="head">
    <div style="font-size: 16px;text-align:center;">HOJA DE<br/> CORTE</div>
    <div id="title" style="font-size: 24px;font-weight:bold;background-color:yellow;">{{cabecera.marca}} {{cabecera.producto}} MOD.- {{cabecera.modelos}}</div>
    <div style="font-size: 16px;text-align:center;">CORTE N°.-</div>
    <div style="font-size:29px;font-weight:bold;background-color:yellow;">{{nrocorte}}</div>
  </div>
  <div id="subhead">
    <div>FECHA COMERCIAL: {{#comercial cabecera.fec_entrega}}{{/comercial}}</div>
    <div>ORDEN DE PEDIDO: {{cabecera.oc}}</div>
    <div>FECHA GENERADA: {{cabecera.fec_emitida}}</div>
  </div>
  <div>
    <table id="liquidacion" width="100%" border="1">
      <thead>
        <th>PROVEEDOR</th>
        <th>COLORES</th>
        <th>TONOS</th>
        <th>ANCHO</th>
        <th>METRO</th>
        <th>PESO</th>
        <th>PAÑOS</th>
        <th>26/XS</th>
        <th>28/S</th>
        <th>30/M</th>
        <th>32/L</th>
        <th>34/XL</th>
        <th>36/XXL</th>
        <th>TOTAL</th>
      </thead>
      <tbody>
        {{#relleno}}
        {{/relleno}}
        <tr style="background-color: rgb(172, 172, 172);height: 25px;">
          <td style="text-align: center;font-weight:bolder;font-size:14px;">TOTALES</td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
        </tr>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="14">RUTA: {{ruta}}</td>
        </tr>
        <tr>
          <td colspan="14">Observacion</td>
        </tr>
      </tfoot>
    </table>
  </div>
  <div>
    <div id="firmas_container">
      <div>JEFFERSON TAPIA<br/>JEFE DE PRODUCCION</div>
      <div>ALMACEN</div>
      <div>MODELISTA</div>
      <div>CORTADOR</div>
      <div>SUPERVISOR</div>
      <div>WILLY MONTOYA<br/>SALIDA Y INGRESO</div>
    </div>
  </div>
</div>
<div style="break-after: page">
  <div>
    <table id="liquidacion" width="100%" border="1">
      <thead>
        <th>PROVEEDOR</th>
        <th>COLORES</th>
        <th>TONOS</th>
        <th>ANCHO</th>
        <th>METRO</th>
        <th>PESO</th>
        <th>PAÑOS</th>
        <th>26/XS</th>
        <th>28/S</th>
        <th>30/M</th>
        <th>32/L</th>
        <th>34/XL</th>
        <th>36/XXL</th>
        <th>TOTAL</th>
      </thead>
      <tbody>
        {{#relleno2}}
        {{/relleno2}}
        <tr style="background-color: rgb(172, 172, 172);height: 25px;">
          <td style="text-align: center;font-weight:bolder;font-size:14px;">TOTALES</td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
<div style="break-after: page">
  {{#relleno3 cabecera}}
  {{/relleno3}}
</div>
